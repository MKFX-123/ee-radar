# 从项目根目录运行 python -m server；默认仅监听本机。
EE_RADAR_DB_PATH=server/data/radar.sqlite3
# 也可在 Radar 助手设置模型；优先级：本地界面保存配置 > 以下环境变量。
# 界面配置保存到 server/data/model-config.json（权限0600，不纳入版本控制）。
# 清除界面配置会回退环境变量，不修改此文件或用户.env。
# 仅使用团队获准使用的模型服务；留空时只返回可追溯检索结果。
EE_RADAR_AI_BASE_URL=
EE_RADAR_AI_API_KEY=
EE_RADAR_AI_MODEL=

# 后台自动增量同步；关闭定时器后仍可在页面手动刷新。
EE_RADAR_SYNC_ENABLED=true
# 首次启动延迟 5 秒，之后每 15 分钟同步所有 enabled 信源。
EE_RADAR_SYNC_STARTUP_DELAY_SECONDS=5
EE_RADAR_SYNC_INTERVAL_SECONDS=900
# 每来源本轮最多处理 20 条，AI 每轮最多处理 10 条待分析资讯。
EE_RADAR_SYNC_LIMIT=20
EE_RADAR_AI_BATCH_SIZE=10
